{
  "name": "nakama-ts-mod",
  "version": "0.1.0",
  "private": true,
  "description": "Nakama server TypeScript module for async turn-based matches",
  "scripts": {
    "build": "tsc --noEmit && node ./scripts/build.cjs",
    "restart:nakama": "cd .. && docker compose restart nakama",
    "build:server": "npm run build && npm run restart:nakama && npm run test:rpc",
    "test:rpc": "node ./scripts/smoke-rpc.mjs",
    "test": "node ./test/test_skill_library_effects.mjs",
    "test:tutorial-scenario": "node ./scripts/test-tutorial-scenario.mjs",
    "test:tutorial-profile-gate": "node ./scripts/test-tutorial-profile-gate.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.23.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "nakama-runtime": "https://github.com/heroiclabs/nakama-common#v1.47.0"
  }
}
